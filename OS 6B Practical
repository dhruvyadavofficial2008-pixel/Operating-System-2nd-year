p = [["P1", 0, 5], ["P2", 1, 3], ["P3", 2, 6]]
q = 2

print("S123 Dhruv Yadav")

rem = [5, 3, 6]
ct = [0, 0, 0]
time = 0
queue = [0]

print("\nGantt Chart:")

while queue:
    i = queue.pop(0)
    run = min(q, rem[i])

    print(f"{time}-{time+run}: {p[i][0]}")
    time += run
    rem[i] -= run

    for j in range(3):
        if p[j][1] <= time and rem[j] > 0 and j not in queue:
            if j != i:
                queue.append(j)

    if rem[i] > 0:
        queue.append(i)
    else:
        ct[i] = time

tat = [ct[i] - p[i][1] for i in range(3)]
wt = [tat[i] - p[i][2] for i in range(3)]

print("\nProcess\tTAT\tWT")
for i in range(3):
    print(f"{p[i][0]}\t{tat[i]}\t{wt[i]}")

print("\nAverage TAT =", round(sum(tat)/3, 2), "ms")
print("Average WT  =", round(sum(wt)/3, 2), "ms")
