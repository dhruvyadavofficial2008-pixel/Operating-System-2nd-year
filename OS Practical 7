import threading
import time
import random

BUFFER_SIZE = 5
buffer = [None] * BUFFER_SIZE

in_pos = 0
out_pos = 0

mutex = threading.Lock()
empty = threading.Semaphore(BUFFER_SIZE)
full = threading.Semaphore(0)


def producer():
    global in_pos

    for item in range(1, 11):
        empty.acquire()          

        with mutex:              
            buffer[in_pos] = item
            print(f"Producer produced: {item} -> Buffer: {buffer}")
            in_pos = (in_pos + 1) % BUFFER_SIZE

        full.release()          
        time.sleep(random.uniform(0.2, 0.5))


def consumer():
    global out_pos

    for _ in range(10):
        full.acquire()         

        with mutex:              
            item = buffer[out_pos]
            buffer[out_pos] = None
            print(f"Consumer consumed: {item} -> Buffer: {buffer}")
            out_pos = (out_pos + 1) % BUFFER_SIZE

        empty.release()          
        time.sleep(random.uniform(0.3, 0.6))


p = threading.Thread(target=producer)
c = threading.Thread(target=consumer)

p.start()
c.start()

p.join()
c.join()

print("\nS123 Dhruv Yadav")
print("Producer-Consumer execution completed.")
